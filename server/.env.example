PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
CLIENT_ORIGIN=http://localhost:5173

# Gmail notifications for the contact form (use a Gmail App Password, not your normal password)
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=
EMAIL_TO=your.gmail@gmail.com
# Or, on hosts that block SMTP (e.g. Render free plan): API key from https://resend.com (used instead of Gmail when set)
RESEND_API_KEY=
